{
  "name": "fuelops-security-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:rules && npm run test:purge",
    "test:rules": "firebase emulators:exec --project demo-fuelops --only firestore \"node --test --test-concurrency=1 --test-reporter=dot tests/firestore.rules.test.mjs\"",
    "check:js": "find js scripts tests -type f -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "purge:station-data": "node scripts/purge-station-data.mjs",
    "test:purge": "node --test tests/purge-script.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "15.30.1"
  }
}
