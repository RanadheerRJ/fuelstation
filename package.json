{
  "name": "fuelstation",
  "version": "1.0.0",
  "private": true,
  "description": "FuelOps - static vanilla-JS PWA. No build step; npm is used only for Firestore rules testing and deployment.",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project fuelops-test \"node tests/firestore-rules.test.mjs\"",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.29.1"
  }
}
