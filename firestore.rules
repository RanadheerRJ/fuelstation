rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'owner';
    }

    function isManagerOrAbove() {
      return isSignedIn() && getUserData().role in ['super_admin','owner','admin','manager'];
    }

    function hasStationAccess(stationId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        stationId in getUserData().stationIds
      );
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection - PIN must never be exposed
    // Super Admin can do everything, invite-only system
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isSameUser(userId) ||
        isSuperAdmin() ||
        isOwner() ||
        getUserData().role in ['admin','manager']
      );
      // Create: super_admin can create owners, owner/admin/manager can create employees
      allow create: if isSuperAdmin() || isManagerOrAbove();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        isSameUser(userId) ||
        getUserData().role in ['admin','manager']
      );
      // Prevent role escalation: only super_admin can set super_admin or owner roles
      allow update: if isSignedIn() && (
        (request.resource.data.role == resource.data.role) ||
        isSuperAdmin() ||
        (isOwner() && request.resource.data.role in ['admin','manager','attendant'])
      );
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Stations - super_admin can create for inviting owners
    match /stations/{stationId} {
      allow read: if isSignedIn() && hasStationAccess(stationId);
      allow create: if isSuperAdmin() || isOwner();
      allow update: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(stationId));
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Pumps
    match /pumps/{pumpId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(request.resource.data.stationId));
      allow update, delete: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(resource.data.stationId));
    }

    // Nozzles
    match /nozzles/{nozzleId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(request.resource.data.stationId));
      allow update: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(resource.data.stationId));
      allow update: if isSignedIn() && hasStationAccess(resource.data.stationId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReading','updatedAt']);
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Prices
    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(request.resource.data.stationId));
      allow update: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(resource.data.stationId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effectiveTo','updatedAt']));
      allow delete: if false;
    }

    // Shifts
    match /shifts/{shiftId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn() && hasStationAccess(request.resource.data.stationId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'ACTIVE';
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'ACTIVE' && request.resource.data.status == 'PENDING_REVIEW') ||
        (isManagerOrAbove() && hasStationAccess(resource.data.stationId) && request.resource.data.status in ['APPROVED','REJECTED','PENDING_REVIEW']) ||
        (resource.data.status != 'APPROVED' && resource.data.userId == request.auth.uid)
      );
      allow update: if isSuperAdmin() || resource.data.status != 'APPROVED' || isOwner();
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn() && hasStationAccess(request.resource.data.stationId);
      allow update: if isSignedIn() && hasStationAccess(resource.data.stationId) && resource.data.status != 'locked';
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Notes
    match /notes/{noteId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn() && hasStationAccess(request.resource.data.stationId);
      allow update, delete: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid || isManagerOrAbove());
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isOwner() || hasStationAccess(resource.data.stationId));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create, update: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(request.resource.data.stationId));
      allow delete: if isSuperAdmin() || isOwner();
    }
  }
}
