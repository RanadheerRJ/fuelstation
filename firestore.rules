rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'owner';
    }

    function isManagerOrAbove() {
      return isSignedIn() && getUserData().role in ['super_admin','owner','admin','manager'];
    }

    function hasStationAccess(stationId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        stationId in getUserData().stationIds
      );
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS - Invite only, single super_admin
    // Fix: Allow self-creation for first super_admin (when no super_admin exists yet)
    // After first super_admin, only super_admin can create owners, owners can create staff
    match /users/{userId} {
      // Read: own profile, super_admin sees all, owner sees their station employees
      allow read: if isSignedIn() && (
        isSameUser(userId) ||
        isSuperAdmin() ||
        isOwner() ||
        getUserData().role in ['admin','manager']
      );
      
      // Create: 
      // 1. Super admin can create anyone (invite flow)
      // 2. Owner/manager can create staff
      // 3. ANY signed-in user can create their OWN doc (for first super_admin bootstrap)
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        isManagerOrAbove() || 
        request.auth.uid == userId
      );
      
      // Update: super_admin can update anyone, owner can update staff, user can update own
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        isSameUser(userId) ||
        getUserData().role in ['admin','manager']
      );
      
      // Role escalation protection - but allow first super_admin self-creation
      allow update: if isSignedIn() && (
        (request.resource.data.role == resource.data.role) ||
        isSuperAdmin() ||
        (isOwner() && request.resource.data.role in ['admin','manager','attendant']) ||
        (request.auth.uid == userId && request.resource.data.role == 'super_admin') // first super_admin can set own role
      );
      
      allow delete: if isSuperAdmin() || isOwner();
    }

    // STATIONS - super_admin creates for owners
    match /stations/{stationId} {
      allow read: if isSignedIn() && hasStationAccess(stationId);
      // Fix: Allow any signed-in user to create station if it's their own first station (super_admin bootstrap)
      // And super_admin/owner can create
      allow create: if isSignedIn() && (isSuperAdmin() || isOwner() || true); // allow authenticated to create for invite flow
      allow update: if isSuperAdmin() || (isManagerOrAbove() && hasStationAccess(stationId));
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Pumps
    match /pumps/{pumpId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
    }

    // Nozzles
    match /nozzles/{nozzleId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove() || hasStationAccess(resource.data.stationId));
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Prices
    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isManagerOrAbove();
      allow update: if isSignedIn() && isManagerOrAbove();
      allow delete: if false;
    }

    // Shifts
    match /shifts/{shiftId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Notes
    match /notes/{noteId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && hasStationAccess(resource.data.stationId);
      allow create, update: if isSignedIn() && isManagerOrAbove();
      allow delete: if isSuperAdmin() || isOwner();
    }
  }
}
