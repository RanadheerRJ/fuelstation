rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'owner';
    }

    function isManagerOrAbove() {
      return isSignedIn() && getUserData().role in ['super_admin','owner','admin','manager'];
    }

    function hasStationAccess(stationId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        (getUserData().stationIds != null && stationId in getUserData().stationIds)
      );
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS - Invite only, single super_admin
    match /users/{userId} {
      // FIX: Allow any signed-in user to read users (needed for team directory, employee list, and to avoid permission denied for attendants)
      // Attendants were getting permission denied because they couldn't list users
      allow read: if isSignedIn();
      
      // Create: super_admin, manager+, or self (first super_admin bootstrap)
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        isManagerOrAbove() || 
        request.auth.uid == userId
      );
      
      // Update: super_admin, owner, self, admin/manager can update
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        isSameUser(userId) ||
        getUserData().role in ['admin','manager']
      );
      
      allow delete: if isSuperAdmin() || isOwner();
    }

    // STATIONS - FIX: Allow all signed-in to read, so attendants don't get permission denied on list
    // Filtering is done client-side in getStationsForCurrentUser()
    match /stations/{stationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isOwner() || true);
      allow update: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove() || hasStationAccess(stationId));
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner() || getUserData().role in ['owner','admin']);
    }

    // Pumps - FIX: Allow read for all signed-in, write for manager+
    match /pumps/{pumpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
    }

    // Nozzles - FIX: Allow read for all signed-in
    match /nozzles/{nozzleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner() || getUserData().role in ['owner','admin']);
    }

    // Prices - FIX: Allow read for all signed-in (attendants need to see price during shift)
    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isManagerOrAbove();
      allow update: if isSignedIn() && isManagerOrAbove();
      allow delete: if false;
    }

    // Shifts - FIX: Allow read for all signed-in, so attendant can see own shifts
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner() || getUserData().role in ['owner','admin']);
    }

    // Transactions - FIX: Allow read for all signed-in
    match /transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner() || getUserData().role in ['owner','admin']);
    }

    // Notes - FIX: Allow read for all signed-in
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Audit Logs - FIX: Allow read for all signed-in
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Assignments - FIX: Allow read for all signed-in
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isManagerOrAbove();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner() || getUserData().role in ['owner','admin']);
    }
  }
}
