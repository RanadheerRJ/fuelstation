rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore Rules are the authorization boundary. Frontend role checks only
    // control presentation and must never grant access on their own.

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUserExists() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function getUserData() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return currentUserExists()
        && getUserData().status == 'active';
    }

    function hasRole(role) {
      return isActiveUser() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isManager() {
      return hasRole('manager');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAttendant() {
      return hasRole('attendant');
    }

    function hasStationAssignment(stationId) {
      return isActiveUser()
        && getUserData().stationIds is list
        && stationId in getUserData().stationIds;
    }

    function ownsStation(stationId) {
      return isOwner()
        && exists(/databases/$(database)/documents/stations/$(stationId))
        && get(/databases/$(database)/documents/stations/$(stationId)).data.ownerId == request.auth.uid;
    }

    function isStationMember(stationId) {
      let user = getUserData();
      return currentUserExists()
        && user.status == 'active'
        && (
          user.role == 'super_admin'
          || (user.stationIds is list && stationId in user.stationIds)
          || (user.role == 'owner'
            && exists(/databases/$(database)/documents/stations/$(stationId))
            && get(/databases/$(database)/documents/stations/$(stationId)).data.ownerId == request.auth.uid)
        );
    }

    function canOperateStation(stationId) {
      let user = getUserData();
      return currentUserExists()
        && user.status == 'active'
        && user.role in ['super_admin', 'owner', 'manager', 'admin']
        && (
          user.role == 'super_admin'
          || (user.stationIds is list && stationId in user.stationIds)
          || (user.role == 'owner'
            && exists(/databases/$(database)/documents/stations/$(stationId))
            && get(/databases/$(database)/documents/stations/$(stationId)).data.ownerId == request.auth.uid)
        );
    }

    function canManageStation(stationId) {
      return canOperateStation(stationId);
    }

    function canManageEmployees(stationId) {
      return canOperateStation(stationId);
    }

    function canReviewShift(stationId) {
      return canOperateStation(stationId);
    }

    function canModifyOwnShift() {
      return isActiveUser()
        && isStationMember(resource.data.stationId)
        && resource.data.userId == request.auth.uid;
    }

    function isApprovedShift() {
      return resource.data.status == 'APPROVED';
    }

    function isOwnerOfResource() {
      return isActiveUser() && (
        (resource.data.keys().hasAny(['userId'])
          && resource.data.userId == request.auth.uid)
        || (resource.data.keys().hasAny(['createdBy'])
          && resource.data.createdBy == request.auth.uid)
        || (resource.data.keys().hasAny(['staffUserId'])
          && resource.data.staffUserId == request.auth.uid)
      );
    }

    function hasValidStationId(data) {
      return data.stationId is string
        && data.stationId.size() > 0;
    }

    function stationIdIsUnchanged() {
      return request.resource.data.stationId == resource.data.stationId;
    }

    function validRole(role) {
      return role in ['super_admin', 'owner', 'manager', 'admin', 'attendant'];
    }

    function validUserStatus(status) {
      return status in ['active', 'inactive'];
    }

    function validResourceStatus(status) {
      return status in ['active', 'inactive', 'ARCHIVED', 'RETIRED'];
    }

    function validFuelType(fuelType) {
      return fuelType in ['Petrol', 'Diesel', 'Premium Petrol', 'CNG', 'MS', 'HSD'];
    }

    function validNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function callerStationIds() {
      return getUserData().stationIds;
    }

    function stationsAreWithinCallerAuthority(stationIds) {
      return isSuperAdmin()
        || (isActiveUser()
          && callerStationIds() is list
          && stationIds is list
          && stationIds.size() > 0
          && stationIds.hasOnly(callerStationIds()));
    }

    function userHasValidShape(data) {
      return data.keys().hasAll(['name', 'phone', 'role', 'stationIds', 'status'])
        && data.keys().hasOnly([
          'name', 'phone', 'role', 'stationIds', 'status',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.phone.matches('^[0-9]{10}$')
        && validRole(data.role)
        && data.stationIds is list
        && validUserStatus(data.status);
    }

    function sharesManagedStation(targetData) {
      return targetData.stationIds is list
        && callerStationIds() is list
        && targetData.stationIds.hasAny(callerStationIds());
    }

    function canCreateUserProfile(data) {
      return userHasValidShape(data)
        && data.status == 'active'
        && data.createdBy == request.auth.uid
        && (
          isSuperAdmin()
          || (isOwner()
            && data.role in ['manager', 'admin', 'attendant']
            && stationsAreWithinCallerAuthority(data.stationIds))
          || ((isManager() || isAdmin())
            && data.role == 'attendant'
            && stationsAreWithinCallerAuthority(data.stationIds))
        );
    }

    function isSafeSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.stationIds == resource.data.stationIds
        && request.resource.data.status == resource.data.status;
    }

    function ownerCanUpdateStaffProfile() {
      return isOwner()
        && resource.data.role in ['manager', 'admin', 'attendant']
        && request.resource.data.role in ['manager', 'admin', 'attendant']
        && sharesManagedStation(resource.data)
        && stationsAreWithinCallerAuthority(request.resource.data.stationIds);
    }

    function managerCanUpdateStaffProfile() {
      return isManager()
        && resource.data.role in ['manager', 'attendant']
        && request.resource.data.role == resource.data.role
        && sharesManagedStation(resource.data)
        && stationsAreWithinCallerAuthority(request.resource.data.stationIds);
    }

    function adminCanUpdateStaffProfile() {
      return isAdmin()
        && resource.data.role in ['admin', 'manager', 'attendant']
        && request.resource.data.role == resource.data.role
        && sharesManagedStation(resource.data)
        && stationsAreWithinCallerAuthority(request.resource.data.stationIds);
    }

    // User profiles contain roles and station membership, so they receive the
    // strictest handling. New privileged identities must be provisioned by an
    // authenticated authorized caller or an Admin SDK backend (which bypasses
    // Rules after performing its own authorization checks).
    match /users/{userId} {
      allow get, list: if isActiveUser() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || ((isOwner() || isManager() || isAdmin())
          && sharesManagedStation(resource.data))
      );

      allow create: if isActiveUser()
        && canCreateUserProfile(request.resource.data);

      allow update: if isActiveUser()
        && userHasValidShape(request.resource.data)
        && (
          (request.auth.uid == userId && isSafeSelfProfileUpdate())
          || isSuperAdmin()
          || (request.auth.uid != userId && ownerCanUpdateStaffProfile())
          || (request.auth.uid != userId && managerCanUpdateStaffProfile())
          || (request.auth.uid != userId && adminCanUpdateStaffProfile())
        );

      // Deactivate profiles instead. Authentication deletion is a backend task.
      allow delete: if false;
    }

    function stationHasValidShape(data) {
      return data.keys().hasAll(['name', 'address', 'phone', 'status', 'ownerId', 'createdBy'])
        && data.keys().hasOnly([
          'name', 'address', 'phone', 'status', 'ownerId', 'managerId',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.address is string
        && data.phone is string
        && validResourceStatus(data.status)
        && data.ownerId is string
        && data.createdBy is string;
    }

    function canReadStationDocument(stationId) {
      return isSuperAdmin()
        || hasStationAssignment(stationId)
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /stations/{stationId} {
      allow get, list: if isActiveUser() && canReadStationDocument(stationId);

      allow create: if isActiveUser()
        && stationHasValidShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (
          isSuperAdmin()
          || (isOwner() && request.resource.data.ownerId == request.auth.uid)
        );

      allow update: if isActiveUser()
        && stationHasValidShape(request.resource.data)
        && (
          isSuperAdmin()
          || (isOwner()
            && isStationMember(stationId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdBy == resource.data.createdBy)
          || ((isManager() || isAdmin())
            && isStationMember(stationId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'address', 'phone', 'managerId', 'updatedAt']))
        );

      // Archive stations instead of deleting accounting history from a browser.
      allow delete: if false;
    }

    function pumpHasValidShape(data) {
      return data.keys().hasAll(['stationId', 'name', 'number', 'status', 'createdBy'])
        && data.keys().hasOnly([
          'stationId', 'name', 'number', 'status', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && hasValidStationId(data)
        && data.name is string
        && data.name.size() > 0
        && data.number is number
        && validResourceStatus(data.status);
    }

    match /pumps/{pumpId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId);

      allow create: if canManageStation(request.resource.data.stationId)
        && pumpHasValidShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if canManageStation(resource.data.stationId)
        && stationIdIsUnchanged()
        && pumpHasValidShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSuperAdmin()
        || (isOwner() && isStationMember(resource.data.stationId));
    }

    function nozzleHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'pumpId', 'number', 'fuelType', 'status',
          'lastReading', 'createdBy'
        ])
        && data.keys().hasOnly([
          'stationId', 'pumpId', 'number', 'fuelType', 'status',
          'lastReading', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && hasValidStationId(data)
        && data.pumpId is string
        && data.number is number
        && validFuelType(data.fuelType)
        && validResourceStatus(data.status)
        && validNonNegativeNumber(data.lastReading);
    }

    function nozzlePumpMatchesStation(data) {
      return exists(/databases/$(database)/documents/pumps/$(data.pumpId))
        && get(/databases/$(database)/documents/pumps/$(data.pumpId)).data.stationId == data.stationId;
    }

    match /nozzles/{nozzleId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId);

      allow create: if canManageStation(request.resource.data.stationId)
        && nozzleHasValidShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && nozzlePumpMatchesStation(request.resource.data);

      allow update: if canManageStation(resource.data.stationId)
        && stationIdIsUnchanged()
        && nozzleHasValidShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && nozzlePumpMatchesStation(request.resource.data);

      allow delete: if isSuperAdmin()
        || (isOwner() && isStationMember(resource.data.stationId));
    }

    function tankStockHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'fuelType', 'baselineLiters', 'baselineTime', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'stationId', 'fuelType', 'baselineLiters', 'baselineTime',
          'capacityLiters', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && hasValidStationId(data)
        && validFuelType(data.fuelType)
        && validNonNegativeNumber(data.baselineLiters)
        && (!data.keys().hasAny(['capacityLiters'])
          || data.capacityLiters == null
          || validNonNegativeNumber(data.capacityLiters))
        && data.updatedBy == request.auth.uid;
    }

    match /tankStocks/{stockId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId);

      allow create: if canManageStation(request.resource.data.stationId)
        && tankStockHasValidShape(request.resource.data);

      allow update: if canManageStation(resource.data.stationId)
        && stationIdIsUnchanged()
        && tankStockHasValidShape(request.resource.data);

      allow delete: if isSuperAdmin()
        || (isOwner() && isStationMember(resource.data.stationId));
    }

    function priceHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'fuelType', 'price', 'effectiveFrom',
          'effectiveTo', 'createdBy'
        ])
        && data.keys().hasOnly([
          'stationId', 'fuelType', 'price', 'effectiveFrom',
          'effectiveTo', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && hasValidStationId(data)
        && validFuelType(data.fuelType)
        && validNonNegativeNumber(data.price)
        && data.createdBy is string;
    }

    match /prices/{priceId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId);

      allow create: if canManageStation(request.resource.data.stationId)
        && priceHasValidShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.effectiveTo == null;

      // Price history is append-only. An active record may only be closed once.
      allow update: if canManageStation(resource.data.stationId)
        && stationIdIsUnchanged()
        && priceHasValidShape(request.resource.data)
        && resource.data.effectiveTo == null
        && request.resource.data.effectiveTo != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['effectiveTo', 'updatedAt']);

      allow delete: if false;
    }

    function shiftHasValidCreateShape(data) {
      return data.keys().hasAll([
          'stationId', 'userId', 'employeeName', 'startTime',
          'status', 'nozzles', 'totals', 'correctionRequests'
        ])
        && data.keys().hasOnly([
          'stationId', 'userId', 'employeeId', 'employeeName',
          'startTime', 'businessDate', 'status', 'nozzles', 'totals',
          'correctionRequests', 'createdAt'
        ])
        && hasValidStationId(data)
        && data.userId == request.auth.uid
        && data.employeeName == getUserData().name
        && data.status == 'ACTIVE'
        && data.nozzles is list
        && data.nozzles.size() > 0
        && data.totals is map
        && data.correctionRequests is list
        && data.totals.totalLiters == 0
        && data.totals.totalRevenue == 0
        && data.totals.totalPayments == 0;
    }

    function shiftIdentityIsUnchanged() {
      return request.resource.data.stationId == resource.data.stationId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.startTime == resource.data.startTime;
    }

    function ownShiftUpdateIsAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      return canModifyOwnShift()
        && shiftIdentityIsUnchanged()
        && (
          (oldStatus == 'ACTIVE'
            && newStatus == 'ACTIVE'
            && changed.hasOnly(['nozzles', 'updatedAt']))
          || (oldStatus in ['ACTIVE', 'REJECTED']
            && newStatus == 'PENDING_REVIEW'
            && changed.hasOnly([
                'nozzles', 'totals', 'endTime', 'closeTime', 'status',
                'correctionRequests', 'resubmittedAt', 'updatedAt'
              ]))
          || (oldStatus == 'REJECTED'
            && newStatus == 'REJECTED'
            && changed.hasOnly(['correctionRequests', 'updatedAt']))
        );
    }

    function reviewerContextIsValid() {
      return canReviewShift(resource.data.stationId)
        && resource.data.userId != request.auth.uid
        && shiftIdentityIsUnchanged();
    }

    function reviewerApprovalIsAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return reviewerContextIsValid()
        && resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.status == 'APPROVED'
        && request.resource.data.keys().hasAll(['approvedBy', 'approvedAt'])
        && request.resource.data.approvedBy == request.auth.uid
        && changed.hasOnly([
          'status', 'approvedBy', 'approvedAt',
          'correctionRequests', 'updatedAt'
        ]);
    }

    function reviewerRejectionIsAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return reviewerContextIsValid()
        && resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.status == 'REJECTED'
        && request.resource.data.keys().hasAll([
          'rejectedBy', 'rejectedAt', 'rejectionReason'
        ])
        && request.resource.data.rejectedBy == request.auth.uid
        && changed.hasOnly([
          'status', 'rejectedBy', 'rejectedAt', 'rejectionReason',
          'correctionRequests', 'updatedAt'
        ]);
    }

    function reviewerCorrectionIsAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return reviewerContextIsValid()
        && resource.data.status == 'REJECTED'
        && (
          (request.resource.data.status == 'PENDING_REVIEW'
            && changed.hasOnly([
              'nozzles', 'totals', 'endTime', 'closeTime', 'status',
              'correctionRequests', 'resubmittedAt', 'updatedAt'
            ]))
          || (request.resource.data.status == 'REJECTED'
            && changed.hasOnly(['correctionRequests', 'updatedAt']))
        );
    }

    match /shifts/{shiftId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId)
        && (canReviewShift(resource.data.stationId)
          || resource.data.userId == request.auth.uid);

      allow create: if isActiveUser()
        && isStationMember(request.resource.data.stationId)
        && shiftHasValidCreateShape(request.resource.data);

      // APPROVED shifts are immutable to every client role. Controlled backend
      // correction and settlement workflows can be added later with Admin SDK.
      allow update: if !isApprovedShift()
        && (
          ownShiftUpdateIsAllowed()
          || reviewerApprovalIsAllowed()
          || reviewerRejectionIsAllowed()
          || reviewerCorrectionIsAllowed()
        );

      allow delete: if false;
    }

    function linkedShiftBelongsToCaller(data) {
      return data.shiftId is string
        && exists(/databases/$(database)/documents/shifts/$(data.shiftId))
        && get(/databases/$(database)/documents/shifts/$(data.shiftId)).data.stationId == data.stationId
        && get(/databases/$(database)/documents/shifts/$(data.shiftId)).data.userId == request.auth.uid;
    }

    function linkedShiftAcceptsEntries(data) {
      return linkedShiftBelongsToCaller(data)
        && get(/databases/$(database)/documents/shifts/$(data.shiftId)).data.status in ['ACTIVE', 'REJECTED'];
    }

    function transactionHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'shiftId', 'type', 'amount', 'createdBy'
        ])
        && data.keys().hasOnly([
          'stationId', 'shiftId', 'type', 'customer', 'amount', 'reference',
          'description', 'category', 'fuelType', 'liters', 'nozzleId',
          'createdBy', 'createdAt', 'status'
        ])
        && hasValidStationId(data)
        && data.type in ['credit', 'expense']
        && validNonNegativeNumber(data.amount)
        && data.amount > 0
        && data.createdBy == request.auth.uid
        && (!data.keys().hasAny(['liters']) || validNonNegativeNumber(data.liters));
    }

    match /transactions/{transactionId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId)
        && (canReviewShift(resource.data.stationId)
          || isOwnerOfResource()
          || linkedShiftBelongsToCaller(resource.data));

      allow create: if isActiveUser()
        && isStationMember(request.resource.data.stationId)
        && transactionHasValidShape(request.resource.data)
        && (canReviewShift(request.resource.data.stationId)
          || linkedShiftAcceptsEntries(request.resource.data));

      // Financial entries are append-only.
      allow update, delete: if false;
    }

    function noteHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'shiftId', 'userId', 'userName', 'text'
        ])
        && data.keys().hasOnly([
          'stationId', 'shiftId', 'userId', 'userName', 'text',
          'pumpId', 'nozzleId', 'createdAt'
        ])
        && hasValidStationId(data)
        && data.userId == request.auth.uid
        && data.userName == getUserData().name
        && data.text is string
        && data.text.size() > 0;
    }

    match /notes/{noteId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId)
        && (canReviewShift(resource.data.stationId)
          || resource.data.userId == request.auth.uid
          || linkedShiftBelongsToCaller(resource.data));

      allow create: if isActiveUser()
        && isStationMember(request.resource.data.stationId)
        && noteHasValidShape(request.resource.data)
        && (canReviewShift(request.resource.data.stationId)
          || linkedShiftAcceptsEntries(request.resource.data));

      allow update, delete: if false;
    }

    function settlementHasValidShape(data) {
      return data.keys().hasAll([
          'stationId', 'staffUserId', 'amount', 'type', 'createdBy'
        ])
        && data.keys().hasOnly([
          'stationId', 'staffUserId', 'staffName', 'shiftId', 'shiftIds',
          'amount', 'type', 'method', 'notes', 'createdBy', 'createdByName',
          'createdAt', 'status'
        ])
        && hasValidStationId(data)
        && validNonNegativeNumber(data.amount)
        && data.amount > 0
        && data.type in ['collect', 'return']
        && data.createdBy == request.auth.uid;
    }

    match /settlements/{settlementId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId)
        && (canReviewShift(resource.data.stationId)
          || resource.data.staffUserId == request.auth.uid);

      allow create: if canReviewShift(request.resource.data.stationId)
        && settlementHasValidShape(request.resource.data);

      // Ledger entries are append-only.
      allow update, delete: if false;
    }

    function assignmentHasValidShape(data) {
      return data.keys().hasAll(['stationId'])
        && hasValidStationId(data);
    }

    match /assignments/{assignmentId} {
      allow get, list: if isActiveUser()
        && isStationMember(resource.data.stationId);

      allow create: if canManageStation(request.resource.data.stationId)
        && assignmentHasValidShape(request.resource.data);

      allow update: if canManageStation(resource.data.stationId)
        && stationIdIsUnchanged()
        && assignmentHasValidShape(request.resource.data);

      allow delete: if isSuperAdmin()
        || (isOwner() && isStationMember(resource.data.stationId));
    }

    // Audit logs are written by trusted backend code only. They are readable by
    // station reviewers and super admins, but never mutable through a client SDK.
    match /auditLogs/{auditId} {
      allow get, list: if isActiveUser()
        && (isSuperAdmin()
          || (resource.data.stationId is string
            && canReviewShift(resource.data.stationId)));
      allow create, update, delete: if false;
    }

    // Reserved models for later transactional/inventory phases remain closed
    // until their backend invariants are implemented and tested.
    match /nozzleAssignments/{assignmentId} {
      allow read, write: if false;
    }

    match /stockMovements/{movementId} {
      allow read, write: if false;
    }

    // Deny all undeclared collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
