rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'owner';
    }

    function isManagerOrAbove() {
      return isSignedIn() && getUserData().role in ['super_admin','owner','admin','manager'];
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS - Invite only, single super_admin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        isManagerOrAbove() || 
        request.auth.uid == userId
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isOwner() ||
        isSameUser(userId) ||
        getUserData().role in ['admin','manager']
      );
      allow delete: if isSuperAdmin() || isOwner();
    }

    // STATIONS - Only owner and super_admin can destroy
    match /stations/{stationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isOwner() || true);
      allow update: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      // Only Station Owner and Super Admin can delete station
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Pumps - read all, write manager+, delete owner only
    match /pumps/{pumpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      // Only owner and super_admin can delete (destroy data)
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Nozzles - read all, delete owner only
    match /nozzles/{nozzleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || isManagerOrAbove());
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Prices - read all, write manager+, never delete (history)
    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isManagerOrAbove();
      allow update: if isSignedIn() && isManagerOrAbove();
      allow delete: if false;
    }

    // Shifts - read all, create/update all, delete owner only
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Transactions - read all, delete owner only
    match /transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Notes - read all, create/update/delete all
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Settlements / Collections - Owner can manage collections, read all signed in
    match /settlements/{setId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isManagerOrAbove();
      allow update: if isSignedIn() && isManagerOrAbove();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }

    // Audit Logs - REMOVED as per requirement - no read/write
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Assignments - read all, write manager+, delete owner only
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isManagerOrAbove();
      allow delete: if isSignedIn() && (isSuperAdmin() || isOwner());
    }
  }
}
